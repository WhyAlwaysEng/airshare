# Server Configuration
PORT=3001
WS_PATH=/ws
IP_SALT=change-this-to-a-random-secret-string

# Firebase (optional — leave empty to disable auth)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# TURN Server (Metered.ca)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# STUN (Google public)
STUN_URL=stun:stun.l.google.com:19302
